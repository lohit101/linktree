# Local origin, without a trailing slash. Set your exact HTTPS origin in production.
APP_ORIGIN=http://127.0.0.1:3000

# npm run setup replaces these locally with independently generated secrets.
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PROXY_SHARED_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Local demonstration only. Ignored in production and on non-loopback origins.
# The local demo does NOT prove that a real anti-bot service is working.
ALLOW_LOCAL_DEMO=true

# Use a Cloudflare Turnstile "Managed" widget, limited to your real domain.
# Both are runtime server variables; do not prefix anything with NEXT_PUBLIC_.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HUMANITY_THRESHOLD=75

# Shared atomic rate limits and single-use nonces for production replicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set true ONLY for one long-lived Node process, with no replicas or serverless scaling.
SINGLE_PROCESS_MEMORY=false

# All of the following stay server-only. Examples below are fictional demo data.
# Leave a value empty to omit that contact link. Replace before using publicly.
CONTACT_EMAIL=hello@example.com
CONTACT_PHONE=+1 202 555 0147
CONTACT_INSTAGRAM_URL=
CONTACT_FANVUE_URL=
PRIVATE_BIO=

# Server-only ntfy notifications. Never use NEXT_PUBLIC_ for these values.
NTFY_ENABLED=false
NTFY_TOPIC=
NTFY_TOKEN=
# Optional UTC expiry for temporary User-Agent diagnostics. Blank disables UA forwarding.
NTFY_INCLUDE_USER_AGENT_UNTIL=
NTFY_DAILY_LIMIT=240
CONTACT_TWITTER_URL=https://x.com/yourhandle
CONTACT_PINTEREST_URL=https://www.pinterest.com/yourhandle/

# Optional additional private HTTPS links. Each id must be unique.
# CONTACT_EXTRA_LINKS='[{"id":"portfolio","label":"My portfolio","detail":"Selected work","url":"https://example.com"}]'
