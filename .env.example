# Local origin only. Vercel derives the actual HTTPS origin per request.
APP_ORIGIN=http://127.0.0.1:3000

# Generated by npm run setup. Use the same secret on all production instances.
# No verification-provider key or database is required.
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HUMANITY_THRESHOLD=75

# Optional for client-IP metadata behind your own authenticated reverse proxy.
# Not required on Vercel or for local operation.
PROXY_SHARED_SECRET=

# Public to everyone, including crawlers.
CONTACT_EMAIL=hello@example.com
CONTACT_INSTAGRAM_URL=

# Server-only subscriber destination and bio. Leave empty to omit.
CONTACT_FANVUE_URL=
PRIVATE_BIO=

# Optional server-side notifications. Existing integration needs no new account.
NTFY_ENABLED=false
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_INCLUDE_USER_AGENT_UNTIL=
NTFY_DAILY_LIMIT=240
